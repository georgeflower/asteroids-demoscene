# Copy this file to .env and fill in your Supabase project values.
# Get these from your Supabase project dashboard under Settings > API.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# HMAC secret for score signature verification (generate with: openssl rand -hex 32)
# Also set this in Supabase Edge Function secrets:
#   supabase secrets set VITE_SCORE_HMAC_SECRET=<your-secret>
VITE_SCORE_HMAC_SECRET=<your-64-char-hex-secret>
