# Copy this file to .env and fill in your Supabase project values.
# Get these from your Supabase project dashboard under Settings > API.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-supabase-anon-key>

# Optional build options for hosting from a subfolder on a static host (e.g. Nekoweb):
# VITE_BASE=./          # relative asset paths so the build works under /games/asteroids/
# VITE_ROUTER=hash      # use HashRouter (static hosts have no SPA fallback)
