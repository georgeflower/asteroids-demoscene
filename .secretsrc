# git-secrets configuration for asteroids-demoscene
# Patterns listed here are scanned by git-secrets --scan
# Lines starting with # are comments; blank lines are ignored.
#
# Usage:
#   git secrets --register-aws   (adds AWS patterns)
#   while IFS= read -r p; do
#     [[ "$p" =~ ^#|^$ ]] && continue; git secrets --add "$p"
#   done < .secretsrc

# Supabase service-role key (JWT, always starts with eyJhbGciOi...)
eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}

# HMAC secret env var with an assigned hex value (not a reference like $VAR or import.meta.env)
VITE_SCORE_HMAC_SECRET=[0-9a-fA-F]{32,}

# Hardcoded admin secret
ADMIN_SECRET_KEY=[^$\s"']{8,}

# Generic high-entropy hex strings > 40 chars (may catch HMAC secrets)
[0-9a-f]{64}

# Private key headers
-----BEGIN (RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----

# Generic password assignments in source
password\s*[=:]\s*[^\s$"']{8,}
passwd\s*[=:]\s*[^\s$"']{8,}
secret\s*[=:]\s*[^\s$"']{8,}
