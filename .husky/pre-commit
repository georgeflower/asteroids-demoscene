#!/usr/bin/env sh
# .husky/pre-commit — Block commits that may contain secrets or .env files.
#
# Setup (one-time per developer):
#   npm install --save-dev husky
#   npx husky init
#   # This file is then automatically used on every commit.

set -e

echo "🔍 Pre-commit: checking for secrets..."

# 1. Block any .env files (excluding .env.example) from being committed
if git diff --cached --name-only | grep -E '^\.env$|^\.env\.[^e]'; then
  echo ""
  echo "❌ Commit blocked: A .env file is staged for commit."
  echo "   .env files must never be committed. Remove it with:"
  echo "     git restore --staged .env"
  echo ""
  exit 1
fi

# 2. Scan staged files for common secret patterns
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | \
  grep -E '\.(ts|tsx|js|json|sh|toml|yml|yaml)$' || true)

if [ -n "$STAGED_FILES" ]; then
  PATTERNS=(
    'SUPABASE_SERVICE_ROLE_KEY\s*=\s*[a-zA-Z0-9_.-]+'
    'ADMIN_SECRET_KEY\s*=\s*[a-zA-Z0-9_.-]+'
    'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9\.[a-zA-Z0-9_-]{50,}'
  )
  FOUND=0
  for PATTERN in "${PATTERNS[@]}"; do
    # shellcheck disable=SC2046
    if echo "$STAGED_FILES" | xargs grep -lE "$PATTERN" 2>/dev/null; then
      echo "❌ Potential secret found in staged file(s) matching: $PATTERN"
      FOUND=1
    fi
  done
  if [ "$FOUND" -eq 1 ]; then
    echo ""
    echo "❌ Commit blocked: potential secret detected in staged files."
    echo "   Review the files above and remove any hardcoded credentials."
    echo ""
    exit 1
  fi
fi

echo "✅ No secrets detected. Proceeding with commit."
